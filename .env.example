NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Aura exports this as NEO4J_USERNAME; either name is accepted.
NEO4J_USERNAME=
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Optional hosted LLM. Google Gemini is the primary supported hosted provider.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Optional OpenAI-compatible fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local/default models.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-base

# Optional crawler controls.
CRAWLER_PROXY_URL=
CRAWLER_COOKIE_JAR=data/crawler_cookies.json
